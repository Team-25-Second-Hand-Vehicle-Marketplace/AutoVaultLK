# Copy to .env for standalone runs. The root .env is also read (../.env).
# Leave secrets empty here; put real values only in the git-ignored .env.

NODE_ENV=development
PORT=3004
ADMIN_PORT=3004

ADMIN_DATABASE_URL=
DATABASE_SSL=false
DISABLE_VERBOSE_ERRORS=false

AWS_REGION=
INTERNAL_SERVICE_KEY=

AUTH_INTERNAL_URL=http://localhost:3001
AUTH_SERVICE_INTERNAL_URL=http://localhost:3001
MARKETPLACE_INTERNAL_URL=http://localhost:3002
NOTIFICATION_INTERNAL_URL=http://localhost:3005

VERIFICATION_DOCS_BUCKET=
VERIFICATION_DOCS_LOCAL_ROOT=
DOCUMENT_SERVE_MODE=
DOCUMENT_PRESIGN_EXPIRY_SECONDS=
