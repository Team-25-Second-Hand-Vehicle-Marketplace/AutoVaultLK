{
  "name": "marketplace-database",
  "private": true,
  "scripts": {
    "typeorm": "typeorm-ts-node-commonjs",
    "migration:create": "npm run typeorm -- migration:create",
    "migration:generate": "npm run typeorm -- migration:generate -d src/data-source.ts",
    "migration:run": "npm run typeorm -- migration:run -d src/data-source.ts",
    "migration:revert": "npm run typeorm -- migration:revert -d src/data-source.ts",
    "migration:show": "npm run typeorm -- migration:show -d src/data-source.ts",
    "grants": "docker exec -i vehicle_marketplace_postgres psql -U marketplace -d vehicle_marketplace -f - < src/grants.sql",
    "db:setup": "npm run migration:run && npm run grants",
    "seed:dictionaries": "ts-node src/seeds/vehicle-dictionaries.seed.ts",
    "seed:vehicles": "ts-node src/seeds/vehicles.seed.ts",
    "seed:embeddings": "ts-node src/seeds/embeddings.seed.ts",
    "seed:admin": "ts-node src/seeds/admin-user.seed.ts"
  },
  "dependencies": {
    "@xenova/transformers": "^2.17.2",
    "bcryptjs": "^3.0.3",
    "dotenv": "^16.4.7",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  }
}
