# Copy to .env at the repo root (see Documentation/database-developer-setup.md)

# --- Database (local Docker Postgres on host port 5433) ---
DATABASE_URL=postgresql://marketplace:marketplace@localhost:5433/vehicle_marketplace
AUTH_DATABASE_URL=postgresql://auth_service_role:dev_auth@localhost:5433/vehicle_marketplace
MARKETPLACE_DATABASE_URL=postgresql://marketplace_service_role:dev_marketplace@localhost:5433/vehicle_marketplace
INGESTION_DATABASE_URL=postgresql://ingestion_service_role:dev_ingestion@localhost:5433/vehicle_marketplace
NOTIFICATION_DATABASE_URL=postgresql://notification_service_role:dev_notification@localhost:5433/vehicle_marketplace
ADMIN_DATABASE_URL=postgresql://admin_service_role:dev_admin@localhost:5433/vehicle_marketplace

# Leave unset (or false) for local Docker Postgres — it serves no TLS
# certificate, so enabling this locally breaks every connection.
#
# Set to true ONLY when pointing at RDS, which refuses non-SSL connections
# (rds.force_ssl=1). In AWS this is supplied as a Lambda environment
# variable rather than from this file.
DATABASE_SSL=false

# --- Initial administrator (FR-12: `npm run seed:admin` in database/) ---
# FR-12 forbids public registration for the ADMIN role, so the first
# administrator can only come from this seed. There is deliberately no default
# password — the seed refuses to run without one rather than baking a
# credential that is identical in every checkout of this repo.
#
# Must satisfy the same policy as registration: 8+ characters, mixed case,
# and a number. Re-running the seed does NOT rotate an existing password.
ADMIN_SEED_EMAIL=admin@autovault.lk
ADMIN_SEED_NAME=System Administrator
ADMIN_SEED_PASSWORD=

# --- Service ports (must match api-gateway/local/nginx.conf upstreams) ---
AUTH_PORT=3001
MARKETPLACE_PORT=3002
INGESTION_PORT=3003
ADMIN_PORT=3004
NOTIFICATION_PORT=3005

# Per-service PORT (NestJS reads process.env.PORT)
PORT=3001

# --- Auth / security ---
JWT_ACCESS_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_ISSUER=autovault-lk-auth
JWT_AUDIENCE=autovault-lk-api
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
MAX_ACTIVE_REFRESH_SESSIONS=5
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOGIN_LOCKOUT_MINUTES=15
AUTH_LOGIN_WINDOW_MINUTES=15
AUTH_IP_MAX_ATTEMPTS=20
AUTH_REGISTER_MAX_PER_IP=5
AUTH_REGISTER_WINDOW_MINUTES=60
AUTH_REFRESH_MAX_PER_IP=30
AUTH_REFRESH_WINDOW_MINUTES=15
AUTH_PASSWORD_RESET_MAX_PER_EMAIL=3
AUTH_PASSWORD_RESET_WINDOW_MINUTES=60
AUTH_PROGRESSIVE_DELAY_BASE_MS=250
AUTH_PROGRESSIVE_DELAY_MAX_MS=4000
EMAIL_VERIFICATION_EXPIRES_HOURS=24
# Local only: include tokens in API responses and print them in the auth console.
# Keep false in production so tokens never leave the mail path.
AUTH_RETURN_VERIFICATION_TOKEN=true
AUTH_RESEND_VERIFICATION_MAX_PER_EMAIL=3
AUTH_RESEND_VERIFICATION_WINDOW_MINUTES=60
PASSWORD_RESET_EXPIRES_MINUTES=60
PASSWORD_HISTORY_COUNT=5
AUTH_RETURN_PASSWORD_RESET_TOKEN=true
CORS_ORIGINS=http://localhost:5173
COOKIE_SECURE=false
AUTH_USE_REFRESH_COOKIES=true
AUTH_REFRESH_TOKEN_IN_BODY=false
HTTP_JSON_BODY_LIMIT=100kb
DISABLE_VERBOSE_ERRORS=false
INTERNAL_SERVICE_KEY=replace-with-a-long-random-internal-service-key

# --- Gateway URLs ---
API_GATEWAY_URL=http://localhost:8080
AUTH_SERVICE_INTERNAL_URL=http://localhost:3001
AUTH_INTERNAL_URL=http://localhost:3001
NOTIFICATION_INTERNAL_URL=http://localhost:3005

# --- SES (notification-service). Empty from-address skips SES and logs locally. ---
SES_FROM_EMAIL=
AWS_REGION=ap-southeast-1
SES_TIMEOUT_MS=5000

# --- Groq (NL search fallback when parse confidence < 0.6; optional locally) ---
# Leave empty to skip Groq and use rules-only filters (SAD 3.6.2).
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT_MS=4000

# --- MiniLM query embeddings (FR-22). true skips vector ranking (NFR-12.1). ---
EMBEDDING_DISABLED=false

# --- SES (notification-service). Empty from-address skips SES and logs locally. ---
SES_FROM_EMAIL=
AWS_REGION=ap-southeast-1
SES_TIMEOUT_MS=5000

# --- SES (notification-service). Empty from-address skips SES and logs locally. ---
SES_FROM_EMAIL=
AWS_REGION=ap-southeast-1
SES_TIMEOUT_MS=5000
