# Copy to .env for standalone runs. The root .env is also read (../.env).
# Leave secrets empty here; put real values only in the git-ignored .env.

NODE_ENV=development
PORT=3005
NOTIFICATION_PORT=3005

NOTIFICATION_DATABASE_URL=
DATABASE_SSL=false
DISABLE_VERBOSE_ERRORS=false

AWS_REGION=
AWS_SQS_ENDPOINT=

SES_FROM_EMAIL=
SES_TIMEOUT_MS=5000

# SMTP is used instead of SES when SMTP_HOST is set.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

NOTIFICATION_RETRY_ENABLED=
NOTIFICATION_RETRY_INTERVAL_MS=30000
NOTIFICATION_RETRY_BATCH_SIZE=
