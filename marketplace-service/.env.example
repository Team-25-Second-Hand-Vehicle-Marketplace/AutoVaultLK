# Copy to .env for standalone runs. The root .env is also read (../.env).
# Leave secrets empty here; put real values only in the git-ignored .env.

NODE_ENV=development
PORT=3002
MARKETPLACE_PORT=3002

MARKETPLACE_DATABASE_URL=
DATABASE_URL=
DATABASE_SSL=false
DISABLE_VERBOSE_ERRORS=false

AWS_REGION=
MARKETPLACE_IMAGES_BUCKET=
MARKETPLACE_IMAGES_LOCAL_ROOT=
IMAGE_SERVE_MODE=
IMAGE_PRESIGN_EXPIRY_SECONDS=

GROQ_API_KEY=
GROQ_API_URL=
GROQ_MODEL=
GROQ_TIMEOUT_MS=

EMBEDDING_DISABLED=false
EMBEDDING_MODEL_CACHE_DIR=
