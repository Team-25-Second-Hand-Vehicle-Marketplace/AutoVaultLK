# Copy to .env for standalone runs. The root .env is also read (../.env).
# Leave secrets empty here; put real values only in the git-ignored .env.

NODE_ENV=development
PORT=3003
INGESTION_PORT=3003

INGESTION_DATABASE_URL=
DATABASE_SSL=false
DISABLE_VERBOSE_ERRORS=false

AWS_REGION=
INGESTION_QUEUE_DRIVER=
INGESTION_SQS_QUEUE_URL=
INGESTION_STORAGE_DRIVER=
INGESTION_STORAGE_ROOT=
IMAGE_PROCESSING_TIMEOUT_MS=

INTERNAL_SERVICE_KEY=
NOTIFICATION_INTERNAL_URL=http://localhost:3005
NOTIFICATION_TIMEOUT_MS=5000

GROQ_API_KEY=
GROQ_API_URL=
GROQ_MODEL=
GROQ_TIMEOUT_MS=

EMBEDDING_DISABLED=false
EMBEDDING_MODEL_CACHE_DIR=
