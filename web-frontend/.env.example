# Leave empty for local development: API calls stay same-origin and go
# through the Vite dev proxy (vite.config.ts), which forwards /marketplace/*
# to marketplace-service on :3002, mirroring api-gateway/local/nginx.conf.
#
# Set to a deployed gateway URL for other environments, e.g.
# VITE_API_BASE_URL=https://<api-id>.execute-api.ap-southeast-1.amazonaws.com/dev
VITE_API_BASE_URL=
